</Synset>
<Synset id="behavior1" partOfSpeech="n">
<Definition>manner of acting or conducting oneself</Definition>
<Example>his bad behavior got him expelled</Example>
</Synset>
<Synset id="defense1" partOfSpeech="n">
<Definition>the action of defending against attack</Definition>
<Example>the defence of the city was heroic</Example>
</Synset>
<Synset id="gray1" partOfSpeech="a">
